# ➤ Keys and addresses the builder reads from builder/.env (never committed). Every source here
# ➤ is an intermediary's partner programme: free, they pay the site per click, and their
# ➤ adverts show in their own section, after the employers' own. Leave a line out and that
# ➤ source is skipped.

# Adzuna developer app (developer.adzuna.com): 250 calls a day, 2,500 a month on the free tier.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble partner API (jooble.org/api/about): one key, or one per country as "es=KEY1,de=KEY2".
JOOBLE_KEY=
JOOBLE_KEYS=

# XML job feeds from partner programmes, "name=url" pairs separated by semicolons.
# Names known: talentcom (employers.talent.com/publishers), whatjobs (whatjobs.com/affiliates), jobtome.
VIA_FEEDS=
