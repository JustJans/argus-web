# The home server's schedule. Install it with:  crontab ops/crontab
# Stop everything with:  touch builder/state/STOP     Start again with:  rm builder/state/STOP
# The crawler reads sources into the store every hour; the publisher builds and pushes the
# site from the store every three hours; the scouts look for new sources once a day. Each
# has its own lock, so a slow run is skipped rather than piled on top of the last one.
7 * * * *    cd $HOME/argus-web && /usr/bin/flock -n builder/state/crawl.lock   ops/server-crawl.sh    >> builder/state/crawl.log 2>&1
23 */3 * * * cd $HOME/argus-web && /usr/bin/flock -n builder/state/publish.lock ops/server-refresh.sh  >> builder/state/publish.log 2>&1
